# Frontend must use the anon/public key only.
# Never put SUPABASE_SERVICE_ROLE_KEY or WHATSAPP_ACCESS_TOKEN in any VITE_* variable.
# Realtime needs these + a Supabase Auth staff login (RLS SELECT on messages/conversations/leads).
# Apply backend/database/migrations/001–007 in the Supabase SQL editor.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=http://localhost:5000/api

# Local/dev bearer token that matches backend DEV_AUTH_TOKEN (memory mode only).
# Ignored when Supabase Auth is configured. Production builds should omit this.
VITE_DEV_AUTH_TOKEN=dev-admin-token

# Optional: allow memory-mode login outside Vite DEV. Never enable in production hosting.
# VITE_ALLOW_DEV_AUTH=true
