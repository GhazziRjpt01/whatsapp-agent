PORT=5000
NODE_ENV=development

# supabase | memory
# Leave unset to auto-select: supabase when real credentials exist, otherwise memory.
DATA_STORE=

# Supabase (backend only)
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — never put this in the frontend.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Local API testing / memory mode auth bypass token
ALLOW_DEV_AUTH_BYPASS=true
DEV_AUTH_TOKEN=dev-admin-token

# AI provider: auto | openai | mock
AI_PROVIDER=auto
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# WhatsApp connects by QR in Settings (no Cloud API token required).
# Session files are stored in backend/data/wa-session (gitignored).
# true => mock sends when the phone is not linked (local tests only)
# Must be false/unset in production
WHATSAPP_MOCK=true
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
# true => process webhook synchronously (useful for local tests)
WHATSAPP_WEBHOOK_SYNC=false

# Comma-separated origins allowed (required in production)
CORS_ORIGIN=http://localhost:5173
